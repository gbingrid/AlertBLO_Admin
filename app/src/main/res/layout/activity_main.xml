<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Spinner
            android:id="@+id/spn_idioma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:minHeight="48dp"
            android:spinnerMode="dialog"
            android:prompt="@string/tit_menu_idioma" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btn_salir"
            android:layout_toEndOf="@id/spn_idioma"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/txt_appname"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_salir"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/txt_salir"
            android:src="@drawable/ic_salir" />

    </RelativeLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="71dp" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.tabs.TabItem
            android:id="@+id/enviar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_enviarAlerta" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/historial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_verHistorial" />
    </com.google.android.material.tabs.TabLayout>

    <EditText
        android:id="@+id/alerta"
        android:layout_width="match_parent"
        android:layout_height="178dp"
        android:textSize="20sp"
        android:hint="@string/txt_text_fondo"
        android:inputType="textMultiLine"
        android:autofillHints="no"
        android:visibility="visible" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/sw_critica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="20dp"
        android:textSize="20sp"
        android:text="@string/sw_critica" />

    <Button
        android:id="@+id/btt_crear"
        android:layout_width="109dp"
        android:layout_height="wrap_content"
        android:text="@string/txt_crear"
        android:textStyle="bold"
        android:textSize="18sp"
        android:backgroundTint="#673AB7"/>

</LinearLayout>