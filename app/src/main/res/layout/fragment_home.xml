<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:background="?attr/android:windowBackground" >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp" >

        <ImageView
            android:id="@+id/logoApp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_vect_logo_app_admin"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/txtAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btn_salir"
            android:layout_toEndOf="@id/logoApp"
            android:layout_marginEnd="8dp"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/txt_appname"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btn_salir"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/txt_salir"
            android:src="@drawable/ic_salir"
            app:tint="?attr/colorOnSurfaceVariant" />

    </RelativeLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="?attr/colorPrimary"
        app:hintTextColor="?attr/colorSurfaceVariant" >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/alerta"
            android:layout_width="match_parent"
            android:layout_height="178dp"
            android:textSize="16sp"
            android:hint="@string/txt_text_fondo"
            android:inputType="textMultiLine"
            android:autofillHints="no"
            android:gravity="top"
            android:visibility="visible" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/sw_critica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="20dp"
        android:textSize="20sp"
        android:text="@string/sw_critica"
        app:thumbTint="@color/switch_thumb_selector"
        app:trackTint="@color/switch_track_selector" />

    <Button
        android:id="@+id/btt_crear"
        android:layout_width="109dp"
        android:layout_height="wrap_content"
        android:text="@string/txt_crear"
        android:textStyle="bold"
        android:textSize="16sp"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="?attr/colorSecondary" />

</LinearLayout>


